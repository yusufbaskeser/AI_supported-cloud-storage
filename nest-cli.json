{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      { "include": "../frontend/**/*", "watchAssets": true },
      { "include": "chat/site-info/**/*.txt", "outDir": "dist", "watchAssets": true }
    ]
  }
}